{
	"name": "frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite --port 3001",
		"build": "run-p type-check \"build-only {@}\" --",
