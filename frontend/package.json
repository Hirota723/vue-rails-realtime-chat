		"@types/node": "^24.13.2",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/test-utils": "^2.4.11",
		"@vue/tsconfig": "^0.8.1",
		"jsdom": "^27.4.0",
		"npm-run-all2": "^8.0.4",
		"typescript": "~5.9.3",
		"vite": "^7.3.5",
		"vite-plugin-vue-devtools": "^8.1.3",
		"vitest": "^4.1.9",
		"vue-tsc": "^3.3.5"
